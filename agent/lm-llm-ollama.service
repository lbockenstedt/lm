[Unit]
Description=Lab Manager CPU Ollama worker
PartOf=lm-agent.service

[Service]
Type=exec
DynamicUser=yes
StateDirectory=lm-llm
Environment=HOME=/var/lib/lm-llm
Environment=OLLAMA_HOST=127.0.0.1:11438
Environment=OLLAMA_MODELS=/var/lib/lm-llm/models
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NUM_PARALLEL=1
# Models stay resident while memory allows; Ollama evicts the least recently used one when
# another model or a larger context needs the room, so no pressure means no reload.
Environment=OLLAMA_MAX_LOADED_MODELS=4
Environment=OLLAMA_KEEP_ALIVE=24h
# A staged bundle store is read-only; startup pruning exits when it cannot remove an empty directory or unused blob.
Environment=OLLAMA_NOPRUNE=1
EnvironmentFile=-/opt/lm-llm/bundle.env
ExecStart=/opt/lm-llm/bin/ollama serve
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
IPAddressDeny=any
IPAddressAllow=localhost
