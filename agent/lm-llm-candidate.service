[Unit]
Description=Lab Manager isolated CPU Ollama qualification runtime
PartOf=lm-agent.service
ConditionPathIsExecutable=/opt/lm-llm-candidate/bin/ollama

[Service]
Type=exec
DynamicUser=yes
StateDirectory=lm-llm-candidate
Environment=HOME=/var/lib/lm-llm-candidate
Environment=OLLAMA_HOST=127.0.0.1:11439
Environment=OLLAMA_MODELS=/var/lib/lm-llm-candidate/models
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
ExecStart=/opt/lm-llm-candidate/bin/ollama serve
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
