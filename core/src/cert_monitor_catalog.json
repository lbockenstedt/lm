      "radsec-eu": "Access Assurance RadSec",
      "redirect": "Device redirect",
      "support-portal": "Support portal"
     },
     "region": "{2}",
     "region_map": {
      "gc1": "Global 02",
      "ac2": "Global 03",
      "gc2": "Global 04",
      "gc4": "Global 05",
      "gc5": "Global 06",
      "gc6": "Global 07",
      "gc7": "Global 08",
      "eu": "EMEA 01",
      "gc3": "EMEA 02",
      "ac6": "EMEA 03",
      "ac5": "APAC 01"
     }
    },
    {
     "re": "^([^.]+)\\.mist\\.com$",
