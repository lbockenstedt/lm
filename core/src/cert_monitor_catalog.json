    },
    {
     "re": "^([^.]+)\\.mistsys\\.net$",
     "role": "{1}",
     "role_map": {
      "manage": "Portal",
      "api": "API",
      "api-ws": "API WebSocket",
      "portal": "Guest portal",
      "ep-terminator": "Device terminator",
