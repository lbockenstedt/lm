  {
   "id": "mist",
   "service": "Juniper Mist",
   "role": null,
   "url": "https://www.juniper.net/documentation/us/en/software/mist/mist-management/topics/ref/firewall-ports-to-open.html",
   "pattern": "{host}\\.(?:mist\\.com|mistsys\\.net)",
   "skip_ports": [
    2200
   ],
   "labels": [
    {
     "re": "^([^.]+)\\.(.+)\\.(?:mist\\.com|mistsys\\.net)$",
     "role": "{1}",
