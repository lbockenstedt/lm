      "api-ws": "API WebSocket",
      "portal": "Guest portal",
      "ep-terminator": "Device terminator",
      "jma-terminator": "Junos agent terminator",
      "ztp": "ZTP",
      "srx-log-terminator": "SRX log terminator",
      "radsec": "Access Assurance RadSec",
