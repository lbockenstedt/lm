#!/bin/bash
# lm-os-update — the only privileged path LM's non-root services (svc_lm) use
# for fleet OS updates (core/src/os_update.py). Installed root-owned to
# /usr/local/bin with a sudoers rule; never run from /opt/lm, which svc_lm can
# write. A fixed set of actions, and package names are validated here too, so
# the sudo grant can't be widened into arbitrary apt arguments.
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive APT_LISTCHANGES_FRONTEND=none NEEDRESTART_MODE=a
CONF=(-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)

case "${1:-}" in
  update)
    exec apt-get update -qq -o DPkg::Lock::Timeout=120 ;;
  dist-upgrade)
    exec apt-get dist-upgrade -y "${CONF[@]}" -o DPkg::Lock::Timeout=600 ;;
  upgrade-only)
    shift
    [ $# -gt 0 ] || { echo "lm-os-update: no packages given" >&2; exit 2; }
    for p in "$@"; do
      [[ "$p" =~ ^[a-z0-9][a-z0-9+.-]*(:[a-z0-9-]+)?$ ]] \
        || { echo "lm-os-update: invalid package name: $p" >&2; exit 2; }
    done
    exec apt-get install --only-upgrade -y "${CONF[@]}" -o DPkg::Lock::Timeout=600 "$@" ;;
  reboot)
    exec shutdown -r +1 "LM: operator-approved reboot" ;;
  *)
    echo "usage: lm-os-update update|dist-upgrade|upgrade-only PKG...|reboot" >&2
    exit 2 ;;
esac
